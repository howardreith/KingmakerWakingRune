<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <KingmakerInstallDir>C:\Path\To\Pathfinder Kingmaker</KingmakerInstallDir>
    <KingmakerManagedDir>$(KingmakerInstallDir)\Kingmaker_Data\Managed</KingmakerManagedDir>
    <!-- Loader build references are fetched separately into obj/loader-references;
         the installed UMM version does not select the compile-time API. -->
  </PropertyGroup>
</Project>
